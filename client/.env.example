# Pinata IPFS Configuration
# Get your API keys from: https://app.pinata.cloud/

REACT_APP_PINATA_API_KEY=your_pinata_api_key_here
REACT_APP_PINATA_SECRET_KEY=your_pinata_secret_key_here

# Pinata Gateway URL (NEW - Required for viewing files)
# Get your dedicated gateway from: https://app.pinata.cloud/gateway
# Format: https://YOUR_SUBDOMAIN.mypinata.cloud/ipfs/
# Example: https://amber-gentle-primate-123.mypinata.cloud/ipfs/
REACT_APP_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Instructions:
# 1. Sign up at https://app.pinata.cloud/
# 2. Go to API Keys section and create a new API key
# 3. Go to Gateways section and get your dedicated gateway URL
# 4. Copy the API Key, Secret Key, and Gateway URL
# 5. Rename this file to .env
# 6. Replace the values above with your actual keys and gateway
# 7. Restart the React app (npm start)

# Note: The default gateway.pinata.cloud may not work.
# You need to use your dedicated gateway subdomain.
